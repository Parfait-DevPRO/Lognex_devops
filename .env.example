# Local PostgreSQL settings
POSTGRES_DB=lognex
POSTGRES_USER=lognex
POSTGRES_PASSWORD=lognex

# Used when running the backend directly from your IDE or with Maven
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lognex
SPRING_DATASOURCE_USERNAME=lognex
SPRING_DATASOURCE_PASSWORD=lognex

# Backend
SPRING_PROFILES_ACTIVE=local
LOGNEX_GENERATOR_RATE=10

# Docker Hub
DOCKER_HUB_USERNAME=your-dockerhub-username
DOCKER_HUB_REPO=lognex

# Frontend
VITE_API_URL=http://localhost:8085
